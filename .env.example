# Turso Database (for Vercel deployment)
# Get these from https://turso.tech app
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Local development (no env needed — uses better-sqlite3 + data.db automatically)
# When TURSO_DATABASE_URL is NOT set, the app uses local SQLite (data.db)
